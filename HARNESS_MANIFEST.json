    "next.config.*",
    "tsconfig*.json",
    "eslint.config.*",
    "postcss.config.*",
    "tailwind.config.*",
    "public/**",
    ".env*"
  ],
  "requiredChecks": {
    "base": [
      "npm run check:auth",
      "npm run lint",
      "npm run type-check"
    ],
    "structural": [
      "npm run build"
    ],
    "harness": [
      "npm run harness -- validate",
      "npm run harness -- self-test",
      "npm run harness -- docs detect"
    ]
  }
}
