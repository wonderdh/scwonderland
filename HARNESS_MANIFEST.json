  "docsSyncRules": [
    {
      "patterns": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx"
      ],
      "docs": [
        "STRUCTURE.md",
        ".claude/routes/_index.md"
      ]
    },
    {
      "patterns": [
        "src/app/**/actions.ts",
        "src/app/**/actions/**",
        "src/app/**/*-actions.ts"
      ],
      "docs": [
        ".claude/rules/domain.md",
        ".claude/routes/shared-actions.md"
      ]
    },
    {
      "patterns": [
        "src/lib/navigation/admin-nav.ts"
      ],
      "docs": [
        "STRUCTURE.md",
        ".claude/routes/_index.md"
      ]
    },
    {
      "patterns": [
        "src/lib/navigation/menu-routes.ts"
      ],
      "docs": [
        "STRUCTURE.md",
        ".claude/routes/_index.md"
      ]
    },
    {
      "patterns": [
        "src/lib/auth/**",
        "src/lib/bus/**",
        "src/lib/constants/**",
        "src/lib/hooks/**",
        "src/lib/lunch/**",
        "src/lib/server/**",
        "src/lib/supabase/**",
        "src/lib/ui/**",
        "src/lib/utils/**",
        "src/lib/types/**"
      ],
      "docs": [
        ".claude/rules/domain.md",
        ".claude/routes/shared-lib.md",
        "STRUCTURE.md"
      ]
    },
    {
      "patterns": [
        "supabase/migrations/**",
        "supabase/config.toml"
      ],
      "docs": [
        ".claude/rules/domain.md",
        ".claude/routes/shared-lib.md",
        "STRUCTURE.md"
      ]
    },
    {
      "patterns": [
        "src/components/**"
      ],
      "docs": [
        ".claude/rules/domain.md",
        ".claude/routes/shared-components.md"
      ]
    },
    {
      "patterns": [
        "scripts/**",
        ".githooks/**",
        ".claude/settings.json",
        ".claude/hooks/**",
        ".claude/skills/**",
        ".claude/agents/**",
        "package.json",
        "package-lock.json"
      ],
      "docs": [
        "STRUCTURE.md",
        ".claude/rules/workflow.md",
        ".claude/rules/testing.md"
      ]
    },
    {
      "patterns": [
        "HARNESS_MANIFEST.json",
        "STRUCTURE.md"
      ],
      "docs": [
        "STRUCTURE.md",
        ".claude/rules/workflow.md"
      ]
    }
  ],
  "protectedPatterns": [
    "src/**",
    "supabase/**",
    "scripts/**",
    ".githooks/**",
