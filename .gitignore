# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worktrees
.worktrees/

# playwright MCP 로그/스냅샷
.playwright-mcp/

# claude 로컬 세션
.claude/settings.local.json
.claude/hooks/session-start.log

# omc (oh-my-claudecode) 세션/상태
.omc/*
# 단, 프로젝트 공용 skills/는 커밋
!.omc/skills/
# skill 작업 중 임시 파일은 ignore
.omc/skills/**/_drafts/

# 로컬 작업 노트 (RLS 패치 SQL, 빌드 스크립트, 설명 md 등)
_notes/

# playwright 스크린샷 (루트 레벨 — 실수로 떨궜을 때 방어)
/*.png
/*.jpg
/*.jpeg
.gstack/

# supabase CLI 로컬 캐시/메타 (config.toml과 migrations/는 커밋 유지)
supabase/.temp/
supabase/.branches/
# seed.sql은 원격 dump일 수 있어 commit 금지 (PII 보호)
supabase/seed.sql
