{
  "permissions": {
    "default_mode": "bypassPermissions"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SPAWN_BACKEND": "tmux"
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "academy-portal|admin-crud|bus-developer|db-architect|notice-manager|site-builder|timetable-developer",
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\scwonderland\\.claude\\scripts\\log-subagent.js start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\scwonderland\\.claude\\scripts\\log-subagent.js stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_supabase_supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "type C:\\scwonderland\\.claude\\rules\\database.md"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\scwonderland\\.claude\\scripts\\inject-route-context.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_supabase_supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\scwonderland\\.claude\\scripts\\post-migration-reminder.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\scwonderland\\.claude\\scripts\\remind-doc-sync.js"
          }
        ]
      }
    ]
  }
}
